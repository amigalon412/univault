# /etc/nginx/sites-available/blurvault
# Reverse-proxy 80/443 -> the standalone server on 127.0.0.1:5013.
# This port must match Environment=PORT in deploy/blurvault.service.
# `certbot --nginx` rewrites this to add the 443 block and the http->https
# redirect automatically; you only author the port-80 block below.
server {
    listen 80;
    server_name blurvault.pro www.blurvault.pro;

    location / {
        proxy_pass http://127.0.0.1:5013;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
