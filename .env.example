# Deployed BlurVault addresses, one per strategy. Leave a value out and that
# strategy renders as "NOT DEPLOYED" rather than showing invented numbers.
#
# These are NEXT_PUBLIC_* because the browser calls the contracts directly.
# Nothing secret belongs here: every value is visible in the shipped bundle.
NEXT_PUBLIC_VAULT_STEADY=
NEXT_PUBLIC_VAULT_BALANCED=
NEXT_PUBLIC_VAULT_GROWTH=

# ExitRouter — powers the one-transaction "sell everything to USDG" button on a
# basketed vault. Leave it blank and that button is simply hidden.
NEXT_PUBLIC_EXIT_ROUTER=

# $BLUR protocol token, once launched. Optional, and normally left blank:
# publish the address from /admin instead, which needs no rebuild. This is only
# a fallback for deploys that would rather bake it in at build time.
NEXT_PUBLIC_BLUR_TOKEN=

# Override only on a custom domain; Vercel supplies its own otherwise.
# NEXT_PUBLIC_SITE_URL=https://blurvault.pro

# ── /admin — publishing the $BLUR contract address after launch ──────────────
#
# SERVER-SIDE ONLY. No NEXT_PUBLIC_ prefix: these must never reach the browser.
#
# Without ADMIN_PASSWORD the admin page is switched off entirely, which is the
# right default. Minimum 12 characters, and it must be random -- whoever holds
# it can make the site vouch for any contract address, so a guessable password
# here is a way to publish a scam CA under your own domain.
#
#   openssl rand -base64 24
ADMIN_PASSWORD=

# Where the published address is stored. MUST live outside the deploy directory
# on a server, or the next redeploy wipes it. Defaults to ./.data locally.
#   BLUR_DATA_DIR=/var/lib/blurvault
BLUR_DATA_DIR=

# Optional. Sessions are signed with a key derived from ADMIN_PASSWORD, so
# rotating the password logs everyone out. Set this to sign them independently.
# ADMIN_SESSION_SECRET=
